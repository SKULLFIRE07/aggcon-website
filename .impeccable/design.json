      "css": ".ds-field{font-family:var(--body,DM,Arial,sans-serif);display:block;color:var(--ink,#171917);font-size:13px;font-weight:600;}.ds-input{font-family:var(--body,DM,Arial,sans-serif);display:block;margin-top:8px;width:100%;min-width:0;border:1px solid #c6c8be;border-radius:3px;background:transparent;padding:13px 15px;color:var(--ink,#171917);font-size:15px;font-weight:400;line-height:1.65;caret-color:#cb4d15;}.ds-input::placeholder{color:#6e7166;opacity:1;}.ds-input:focus-visible{outline:3px solid var(--focus,#cb4d15);outline-offset:5px;}"
