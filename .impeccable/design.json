      "css": ".ds-button-dark{font-family:var(--body,DM,Arial,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:28px;min-height:52px;padding:14px 24px;border:0;border-radius:3px;font-size:13px;font-weight:600;line-height:1.4;cursor:pointer;text-decoration:none;transition:background .2s,transform .25s var(--ease,cubic-bezier(.16,1,.3,1));background:var(--ink,#171917);color:var(--paper,#f4f3ec);}.ds-button-dark:hover{background:#363c31;}.ds-button-dark svg{transition:transform .25s var(--ease,cubic-bezier(.16,1,.3,1));}.ds-button-dark:hover svg{transform:translate(3px,-3px);}.ds-button-dark:focus-visible{outline:3px solid var(--focus,#cb4d15);outline-offset:5px;}.ds-button-dark:disabled{cursor:default;opacity:.55;}@media(prefers-reduced-motion:reduce){.ds-button-dark,.ds-button-dark svg{transition:none;}}"
    },
    {
      "name": "Inline Arrow Link",
      "kind": "button",
      "refersTo": "link-inline",
      "description": "Quiet ruled action used across editorial sections.",
      "html": "<a class=\"ds-inline-link\" href=\"#fleet\">Explore the fleet <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></a>",
      "css": ".ds-inline-link{font-family:var(--body,DM,Arial,sans-serif);color:var(--ink,#171917);display:inline-flex;align-items:center;gap:20px;font-size:13px;font-weight:600;line-height:1.4;padding:6px 0;border-bottom:1px solid currentColor;text-decoration:none;transition:gap .2s;}.ds-inline-link:hover{gap:28px;}.ds-inline-link:focus-visible{outline:3px solid var(--focus,#cb4d15);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-inline-link{transition:none;}}"
    },
