    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Filled rental action with the shipped diagonal-arrow hover.",
      "html": "<button class=\"ds-button-primary\">Explore our fleet <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></button>",
      "css": ".ds-button-primary{font-family:var(--body,DM,Arial,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:28px;min-height:52px;padding:14px 24px;border:0;border-radius:3px;font-size:13px;font-weight:600;line-height:1.4;cursor:pointer;text-decoration:none;transition:background .2s,transform .25s var(--ease,cubic-bezier(.16,1,.3,1));background:var(--orange,#ff6b2c);color:var(--ink,#171917);}.ds-button-primary:hover{background:#ff824c;}.ds-button-primary svg{transition:transform .25s var(--ease,cubic-bezier(.16,1,.3,1));}.ds-button-primary:hover svg{transform:translate(3px,-3px);}.ds-button-primary:focus-visible{outline:3px solid var(--focus,#cb4d15);outline-offset:5px;}.ds-button-primary:disabled{cursor:default;opacity:.55;}@media(prefers-reduced-motion:reduce){.ds-button-primary,.ds-button-primary svg{transition:none;}}"
    },
    {
