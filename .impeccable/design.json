    {
      "name": "Document Filter Tabs",
      "kind": "chip",
      "refersTo": "tab-resource",
      "description": "Outlined investor filters; selected state uses graphite and ivory.",
      "html": "<div class=\"ds-resource-tabs\" role=\"group\" aria-label=\"Document category\"><button class=\"ds-resource-tab ds-resource-selected\" aria-pressed=\"true\">All documents</button><button class=\"ds-resource-tab\" aria-pressed=\"false\">Financial information</button></div>",
      "css": ".ds-resource-tabs{display:flex;flex-wrap:wrap;gap:8px;}.ds-resource-tab{font-family:var(--body,DM,Arial,sans-serif);font-size:10px;line-height:1.65;padding:10px 13px;border:1px solid var(--line,#d7d8ce);border-radius:3px;background:transparent;color:var(--ink,#171917);white-space:nowrap;cursor:pointer;}.ds-resource-selected{background:var(--ink,#171917);color:var(--paper,#f4f3ec);border-color:var(--ink,#171917);}.ds-resource-tab:focus-visible{outline:3px solid var(--focus,#cb4d15);outline-offset:5px;}"
    },
    {
      "name": "Equipment Card",
      "kind": "card",
      "refersTo": "machine-card",
      "description": "Actual catalogue composition with the shipped JCB photograph, ruled metadata and quote action.",
      "html": "<article class=\"ds-machine-card\"><a class=\"ds-machine-visual\" href=\"#machine\"><img src=\"data:image/webp;base64,\" alt=\"JCB 3DX backhoe loader\" /><span class=\"ds-machine-arrow\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></span></a><div class=\"ds-machine-content\"><a class=\"ds-machine-title-link\" href=\"#machine\"><h2 class=\"ds-machine-title\">JCB 3DX</h2></a><span class=\"ds-machine-type\">Backhoe loader</span><div class=\"ds-machine-spec\"><span>JCB</span><span>Material handling</span></div><button class=\"ds-add-quote\">Add to quote <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></button></div></article>",
      "css": ".ds-machine-card{font-family:var(--body,DM,Arial,sans-serif);min-width:0;color:var(--ink,#171917);}.ds-machine-visual{position:relative;display:block;background:#e6e8dd;height:230px;overflow:hidden;}.ds-machine-visual img{display:block;width:100%;height:100%;object-fit:contain;padding:18px;mix-blend-mode:multiply;transition:transform .6s var(--ease,cubic-bezier(.16,1,.3,1));box-sizing:border-box;}.ds-machine-visual:hover img{transform:scale(1.04);}.ds-machine-arrow{position:absolute;top:12px;right:12px;display:flex;align-items:center;justify-content:center;background:var(--paper,#f4f3ec);height:29px;width:29px;border-radius:50%;}.ds-machine-content{padding:16px 0 0;}.ds-machine-title-link{text-decoration:none;color:inherit;}.ds-machine-title{font-family:var(--display,Barlow,'Arial Narrow',sans-serif);font-size:28px;font-weight:700;line-height:1.04;letter-spacing:-.025em;margin:6px 0 0;}.ds-machine-type{display:block;margin-top:8px;font-size:10px;color:var(--muted,#66695f);}.ds-machine-spec{display:flex;justify-content:space-between;gap:10px;margin-top:14px;padding-bottom:17px;border-bottom:1px solid var(--line,#d7d8ce);font-size:9px;color:var(--muted,#66695f);}.ds-add-quote{font-family:var(--body,DM,Arial,sans-serif);display:flex;width:100%;justify-content:space-between;align-items:center;padding:13px 0;font-size:11px;font-weight:600;border:0;border-bottom:1px solid var(--line,#d7d8ce);background:none;color:inherit;cursor:pointer;}.ds-add-quote:hover:not(:disabled){color:#b34818;}.ds-add-quote:disabled{opacity:.65;cursor:default;}.ds-machine-visual:focus-visible,.ds-machine-title-link:focus-visible,.ds-add-quote:focus-visible{outline:3px solid var(--focus,#cb4d15);outline-offset:5px;}@media(max-width:640px){.ds-machine-visual{height:165px;}.ds-machine-visual img{padding:11px;}.ds-machine-content{padding-top:9px;}.ds-machine-title{font-size:23px;margin-top:0;}.ds-machine-type,.ds-machine-spec,.ds-add-quote{font-size:12px;}.ds-machine-spec{flex-direction:column;gap:3px;padding-bottom:12px;margin-top:10px;}.ds-add-quote{padding:11px 0;gap:6px;}}@media(prefers-reduced-motion:reduce){.ds-machine-visual img{transition:none;}}"
    },
